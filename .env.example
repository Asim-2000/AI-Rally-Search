DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_USE_SSL=
ENTITY_SEARCH_FALLBACK_MODE=

QUERY_UNDERSTANDING_PROVIDER=gemini
QUERY_UNDERSTANDING_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_api_key_here

# Provisional production speech selection; human STT validation is deferred.
SPEECH_PROVIDER=openai
SPEECH_MODEL=whisper-1
WHISPER_PRODUCTION_STATUS=PROVISIONAL
OPENAI_API_KEY=your_api_key_here

# Python FastAPI is the sole authoritative search backend (no legacy switch).
# The Flutter app requires this origin; when it is absent the UI shows a clean
# error rather than falling back to any in-app engine.
PYTHON_BACKEND_BASE_URL=http://0.0.0.0:8765/
